# Copy to .env and fill in. Never commit .env.

# Port the Express server listens on.
PORT=3000

# node env: development | production | test
NODE_ENV=development

# A string you invent. You type the SAME value into the Meta app dashboard
# when you subscribe the webhook. Meta echoes it back during the GET handshake
# so we can prove the callback URL is ours. Make it long and random:
#   openssl rand -hex 32
IG_VERIFY_TOKEN=

# Meta App Secret: App Dashboard -> App settings -> Basic -> App Secret.
# Used to verify the X-Hub-Signature-256 HMAC on every incoming POST.
META_APP_SECRET=

# Instagram Page access token. Only needed once we start REPLYING to DMs
# (confirmation messages, the account-linking flow). Ingestion works without it.
IG_ACCESS_TOKEN=

# Write every raw webhook body to data/raw-events.jsonl for inspection.
# Invaluable while designing the parser; turn off in production.
PERSIST_RAW_EVENTS=true
