# Copy to .env and fill in. Never commit .env.

# Port the Express server listens on.
PORT=3000

# node env: development | production | test
NODE_ENV=development

# A string you invent. You type the SAME value into the Meta app dashboard
# when you subscribe the webhook. Meta echoes it back during the GET handshake
# so we can prove the callback URL is ours. Make it long and random:
#   openssl rand -hex 32
IG_VERIFY_TOKEN=

# Meta App Secret, used to verify the X-Hub-Signature-256 HMAC on every
# incoming POST. WHERE TO FIND IT DEPENDS ON WHICH INSTAGRAM PRODUCT THE APP
# USES:
#   - Standalone Instagram API with Instagram Login (no Facebook Page, separate
#     Instagram App ID/permissions during setup): App Dashboard -> Use cases ->
#     Instagram API -> "Instagram app secret". This is a DIFFERENT value from
#     the one below, and is the one that actually signs Instagram DM webhooks
#     for this product.
#   - Instagram via Facebook Login (linked Facebook Page): App Dashboard ->
#     App settings -> Basic -> App Secret.
# Using the wrong one produces a signature that never matches — HMAC is
# correct, JSON parses fine, everything looks right except the digest — which
# makes it easy to burn hours suspecting the tunnel or the code instead.
META_APP_SECRET=

# Instagram Page access token. Only needed once we start REPLYING to DMs
# (confirmation messages, the account-linking flow). Ingestion works without it.
IG_ACCESS_TOKEN=

# Write every raw webhook body to data/raw-events.jsonl, and every parse result
# to data/parsed-saves.jsonl. Invaluable while tuning; turn off in production.
PERSIST_RAW_EVENTS=true

# Anthropic API key: https://console.anthropic.com/settings/keys
# Used to read the place name out of the shared post. Without it the server
# still ingests and logs DMs; parsing skips itself.
ANTHROPIC_API_KEY=

# Google Maps API key with the Places API (New) enabled.
# Turns the extracted place name into a real, verified street address. The model
# is never asked for an address, so without this key a save has no location.
GOOGLE_MAPS_API_KEY=
